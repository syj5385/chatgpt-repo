# private: approved users must log in
# public: anyone can use the FileServer without an account
FILESERVER_ACCESS_MODE=private

# Initial administrator account. The first login requires a password change.
FILESERVER_ADMIN_USER=admin
FILESERVER_ADMIN_PASSWORD=admin

# Session settings
FILESERVER_SESSION_HOURS=12
FILESERVER_REMEMBER_DAYS=30
FILESERVER_PASSWORD_MIN_LENGTH=8
FILESERVER_COOKIE_SECURE=true

# Storage and advanced explorer settings
# 50 GiB default quota per approved user. Set 0 for unlimited.
FILESERVER_DEFAULT_QUOTA_BYTES=53687091200
# Resumable upload chunk size: 8 MiB
FILESERVER_UPLOAD_CHUNK_BYTES=8388608
# Maximum size per file through a public upload-only share: 2 GiB
FILESERVER_PUBLIC_UPLOAD_MAX_BYTES=2147483648
# Number of previous versions retained for each file
FILESERVER_VERSION_LIMIT=20
# Maximum allowed expiration period for a share link
FILESERVER_SHARE_MAX_DAYS=90

# Published ports
FILESERVER_PORT=5080
FILESERVER_HTTPS_PORT=5443

# TLS certificate identity
FILESERVER_CERT_CN=localhost
FILESERVER_CERT_SAN=DNS:localhost,IP:127.0.0.1
FILESERVER_CERT_DAYS=825
