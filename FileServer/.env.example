# private: approved users must log in
# public: anyone can use the FileServer without an account
FILESERVER_ACCESS_MODE=private

# Initial administrator account. The first login requires a password change.
FILESERVER_ADMIN_USER=admin
FILESERVER_ADMIN_PASSWORD=admin

# Session settings
FILESERVER_SESSION_HOURS=12
FILESERVER_REMEMBER_DAYS=30
FILESERVER_PASSWORD_MIN_LENGTH=8
FILESERVER_COOKIE_SECURE=true

# Published ports
FILESERVER_PORT=18080
FILESERVER_HTTPS_PORT=18443

# TLS certificate identity
FILESERVER_CERT_CN=localhost
FILESERVER_CERT_SAN=DNS:localhost,IP:127.0.0.1
FILESERVER_CERT_DAYS=825
